# Local Postgres, started via `make up` (docker-compose), exposed on host port 5433
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/gritio_db

# Only used to sign/verify locally-issued JWTs — any value works for local dev.
# Not set in Railway production either; code falls back to 'your-secret-key' if unset.
JWT_SECRET=local-dev-secret

# Real Auth0 tenant domain, needed only if testing Auth0-based login locally.
# Not currently set in Railway production, so Auth0 login isn't functional there either.
AUTH0_DOMAIN=

NODE_ENV=development
PORT=3000
